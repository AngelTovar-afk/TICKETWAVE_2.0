# ─── Control de versiones ────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ─── Dependencias (se instalan dentro del contenedor) ────────────────────────
vendor/
node_modules/

# ─── Archivos de entorno (nunca al contenedor de producción) ─────────────────
.env
.env.*
!.env.example

# ─── Cache y archivos generados ──────────────────────────────────────────────
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*

# ─── Documentación y archivos del equipo ─────────────────────────────────────
docs/
*.md
README*

# ─── Docker (evitar recursividad) ────────────────────────────────────────────
docker-compose*.yml
!docker/nginx/default.conf
!docker/php/local.ini
!docker/supervisor/supervisord.conf
!docker/start.sh
!docker/ssl/ca.pem

# ─── IDE y herramientas locales ───────────────────────────────────────────────
.idea/
.vscode/
*.DS_Store
Thumbs.db
